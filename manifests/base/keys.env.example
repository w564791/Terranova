# Template for manifests/base/keys.env (gitignored; never commit the real file).
#   cp base/keys.env.example base/keys.env
# then fill in the values below (see manifests/README.md "Quick Deploy" and
# docs/security/signing-and-encryption-keys.md).

# Required with ENV=production. Exactly 32 bytes: openssl rand -base64 32
# Generate ONCE and keep it; changing it without the rotation procedure makes
# encrypted data unreadable.
DATA_ENCRYPTION_KEY=
# Required with ENV=production. >= 32 bytes: openssl rand -base64 48
SIGNING_ROOT_KEY=

# Legacy only. Leave empty on new installs. Upgrades: set to the secret the
# environment used before, ONLY until the re-encryption job reports zero
# legacy rows (it decrypts key_version 0 data). If the environment ever used
# the value that was committed to this repository, also set
# LEGACY_TOKEN_CUTOFF to the deploy time (no window) and rotate.
JWT_SECRET=
# RFC3339; empty = tokens without kid are rejected. Example: 2026-10-17T12:00:00Z
LEGACY_TOKEN_CUTOFF=
